<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        =========================
        NORMALE APP THEME
        =========================
    -->

    <style
        name="AppTheme"
        parent="Theme.AppCompat.Light.DarkActionBar">

        <item name="colorPrimary">
            @color/colorPrimary
        </item>

        <item name="colorPrimaryDark">
            @color/colorPrimaryDark
        </item>

        <item name="colorAccent">
            @color/colorAccent
        </item>

    </style>


    <!--
        =========================
        APP ZONDER ACTION BAR
        =========================
    -->

    <style
        name="AppTheme.NoActionBar"
        parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="windowActionBar">
            false
        </item>

        <item name="windowNoTitle">
            true
        </item>

        <item name="android:background">
            @null
        </item>

    </style>


    <!--
        =========================
        BUSBENDE SPLASHSCREEN
        =========================
    -->

    <style
        name="AppTheme.NoActionBarLaunch"
        parent="Theme.SplashScreen">

        <!-- BusBende geel -->
        <item name="windowSplashScreenBackground">
            #FFD600
        </item>

        <!-- Logo in het midden -->
        <item name="windowSplashScreenAnimatedIcon">
            @drawable/busbende_splash_logo
        </item>

        <!-- Theme nadat splash klaar is -->
        <item name="postSplashScreenTheme">
            @style/AppTheme.NoActionBar
        </item>

    </style>

</resources>